@{
    # The settings of the theme, as under Settings > Design in Ghost Admin. Everything here is public.

    # One of: Logo on the left, Logo in the middle, Stacked
    navigation_layout      = 'Logo on the left'

    # One of: Modern sans-serif, Elegant serif, System fonts
    title_font             = 'Modern sans-serif'

    # One of: Modern sans-serif, Elegant serif, System fonts
    body_font              = 'Modern sans-serif'

    show_publication_cover = $true

    # One of: Left aligned, Center aligned, Highlight
    header_style           = 'Left aligned'

    # One of: Grid, List, Full
    post_feed_style        = 'Grid'

    social_github_url      = 'https://github.com/Gijsreyn'

    social_linkedin_url    = 'https://www.linkedin.com/in/gijs-reijn-582b81198'

    social_bluesky_url     = 'https://bsky.app/profile/gijsreijn.bsky.social'

    # Manual monthly visitor count (e.g., '5.2K', '12K+', '1.5M')
    monthly_visitors_count = '5K+' # Just a counter if the monthly visitors can't be captured from Google Analytics
}
